# Opcional. Só é necessário se a API não estiver em http://localhost:8000.
# No desenvolvimento (npm run dev) o Vite repassa /api para esta URL.
# Para um build que fale com uma API em outro endereço, defina também
# VITE_API_BASE (ex.: https://meu-servidor) antes do npm run build.
VITE_API_URL=http://localhost:8000
